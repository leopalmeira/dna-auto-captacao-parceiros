PORT=3000
NODE_ENV=development

# Producao no Render: gerado automaticamente pela conexao com o PostgreSQL do Render
# Se omitido em desenvolvimento/testes, o sistema usa SQLite local de forma automatica
DATABASE_URL=

# Credenciais administrativas para acesso ao painel de gestao de leads (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dna_auto_parceiros_2026!
SESSION_SECRET=dna_auto_secret_session_key_render_2026_super_secure

# Token para futura integracao segura via API com a plataforma principal DNA Auto
INTEGRATION_API_KEY=dna_integration_key_secret_2026
